# ── Copy to .env and fill in your own values. Never commit .env ──────────────

# ── LLM (OpenRouter — default provider for all current lesson configs) ────────
OPENROUTER_API_KEY=your_openrouter_api_key
# "free" (default) or "paid". See README → Model Tiers.
RAGWIRE_MODEL_TIER=free

# ── Optional LLM providers (used by lesson 03 provider configs) ───────────────
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
HF_TOKEN=your_huggingface_token

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT="RAGWire"

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Leave empty when using the local Docker Qdrant (http://localhost:6333).
# Set both values only when using Qdrant Cloud.
QDRANT_API_KEY=
QDRANT_URL=

# ── FastAPI backend (lesson 06) ───────────────────────────────────────────────
# Selects the agent module in "06 FastAPI RAG Backend/agents/" (default: 01_langchain_agent)
AGENT=01_langchain_agent

# ── Chainlit frontend (lesson 07) ─────────────────────────────────────────────
FASTAPI_URL=http://localhost:8080
API_KEY=
APP_USER=admin
APP_PASSWORD=change-me

# ── Chainlit session secret (use a long random string) ────────────────────────
CHAINLIT_AUTH_SECRET=change-me-to-a-long-random-string